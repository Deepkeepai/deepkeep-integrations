{
  "name": "DeepKeep Input Guardrail",
  "checks": [
    {
      "id": "deepkeep.deepkeepModeration",
      "parameters": {
        "apiBaseUrl": "https://api.deepkeep.example.com",
        "inputFirewallId": "deepkeep-input-firewall",
        "chatId": "",
        "title": "",
        "timeoutMs": 10000,
        "failOpen": true
      }
    }
  ],
  "actions": {
    "deny": true,
    "async": false,
    "on_success": {
      "feedback": {
        "value": 1,
        "weight": 1,
        "metadata": "input passed"
      }
    },
    "on_fail": {
      "feedback": {
        "value": -1,
        "weight": 1,
        "metadata": "input failed"
      }
    }
  }
}
