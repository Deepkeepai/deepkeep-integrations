{
  "id": "deepkeep",
  "description": "DeepKeep guardrail integration for Portkey Gateway",
  "credentials": {
    "type": "object",
    "properties": {
      "apiKey": {
        "type": "string",
        "label": "API Key",
        "description": "DeepKeep API key",
        "encrypted": true
      },
      "bearerToken": {
        "type": "string",
        "label": "Bearer Token",
        "description": "Optional DeepKeep bearer token",
        "encrypted": true
      }
    },
    "required": []
  },
  "functions": [
    {
      "name": "DeepKeep Moderation",
      "id": "deepkeepModeration",
      "type": "guardrail",
      "supportedHooks": ["beforeRequestHook", "afterRequestHook"],
      "description": [
        {
          "type": "subHeading",
          "text": "Call DeepKeep moderation APIs on the input and output of an LLM request."
        }
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "apiBaseUrl": {
            "type": "string",
            "label": "API Base URL",
            "description": [
              {
                "type": "subHeading",
                "text": "DeepKeep API base URL, for example https://api.deepkeep.ai or your self-hosted endpoint."
              }
            ]
          },
          "firewallId": {
            "type": "string",
            "label": "Firewall ID",
            "description": [
              {
                "type": "subHeading",
                "text": "Fallback DeepKeep firewall ID used when inputFirewallId or outputFirewallId are not provided."
              }
            ]
          },
          "inputFirewallId": {
            "type": "string",
            "label": "Input Firewall ID",
            "description": [
              {
                "type": "subHeading",
                "text": "Firewall ID for beforeRequestHook moderation."
              }
            ]
          },
          "outputFirewallId": {
            "type": "string",
            "label": "Output Firewall ID",
            "description": [
              {
                "type": "subHeading",
                "text": "Firewall ID for afterRequestHook moderation."
              }
            ]
          },
          "chatId": {
            "type": "string",
            "label": "Conversation ID",
            "description": [
              {
                "type": "subHeading",
                "text": "Optional DeepKeep conversation identifier."
              }
            ]
          },
          "title": {
            "type": "string",
            "label": "Conversation Title",
            "description": [
              {
                "type": "subHeading",
                "text": "Optional DeepKeep conversation title."
              }
            ]
          },
          "timeoutMs": {
            "type": "number",
            "label": "Timeout (ms)",
            "description": [
              {
                "type": "subHeading",
                "text": "Maximum time to wait for DeepKeep before failing over."
              }
            ],
            "default": 10000
          },
          "failOpen": {
            "type": "boolean",
            "label": "Fail Open",
            "description": [
              {
                "type": "subHeading",
                "text": "Allow the request if DeepKeep returns an error."
              }
            ],
            "default": true
          }
        },
        "required": ["apiBaseUrl"]
      }
    }
  ]
}
