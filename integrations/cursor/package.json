{
    "name": "@deepkeep/agent-guardrails",
    "version": "0.1.0",
    "private": true,
    "description": "DeepKeep firewall as a guardrail for AI coding agents (Cursor, Claude Code).",
    "license": "Apache-2.0",
    "type": "module",
    "engines": {
        "node": ">=20.0.0"
    },
    "bin": {
        "deepkeep-hook": "./dist/cli.js"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "build:plugin": "npm run build && node scripts/scaffold-plugin.mjs && node scripts/bundle-into-plugin.mjs",
        "install:plugin": "npm run build:plugin && bash scripts/install-into-cursor.sh",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "tsc --noEmit",
        "prepack": "npm run build",
        "prepublishOnly": "npm run build",
        "smoke:prompt": "echo '{\"prompt\":\"hi\",\"attachments\":[]}' | node dist/cli.js hook prompt"
    },
    "dependencies": {
        "axios": "^1.7.7",
        "commander": "^12.1.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/node": "^20.14.0",
        "dotenv": "^17.4.2",
        "tsup": "^8.3.0",
        "typescript": "^5.5.4",
        "vite": "^6.4.5",
        "vitest": "^4.1.12"
    }
}
